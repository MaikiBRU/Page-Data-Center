# Secrets
# Every .env and every .env.<anything>, in any directory. The enumeration this
# replaces listed .env.local and .env.production.local but not .env.production
# or .env.staging, so those would have been committed. The pattern only matches
# names beginning with ".env", so it cannot swallow source files.
**/.env
**/.env.*
# ...except the templates, which carry names and comments but no values.
!**/.env.example
!**/.env.*.example

# Dependencies
**/node_modules/

# Python
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/

# Next.js / frontend
**/.next/
**/.open-next/
**/.wrangler/
**/out/
**/build/
**/coverage/
*.tsbuildinfo

# Local caches
.npm-cache/
frontend/.npm-cache/

# Logs and generated runtime files
logs/
*.log

# Generated uploads / local data
data/uploads/

# Local databases and dumps. None exist today, but a stray dev.db or a
# pg_dump in the working tree would otherwise be committed with real rows in
# it. Thumbs.db is matched above by name, not by this pattern.
*.db
*.sqlite
*.sqlite3
*.sql
*.dump

# OS / editor noise
.DS_Store
Thumbs.db
