# Values baked into the client bundle by `next build` when NODE_ENV=production.
#
# This file is committed on purpose: NEXT_PUBLIC_* values are visible in the
# published JavaScript anyway, so there is nothing to hide, and pinning them
# here means a production build no longer depends on whoever runs it having
# remembered to export the right variable.
#
# IMPORTANT: `.env.local` still wins over this file, and Next.js reads it
# during production builds too. A developer machine with a localhost value in
# .env.local would therefore override these. next.config.ts fails the build in
# that case rather than letting a broken bundle ship.
NEXT_PUBLIC_API_URL=https://api-datacenter.aaronbrumat.com.ar
