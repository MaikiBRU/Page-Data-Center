# --- Core -------------------------------------------------------------------
# "development" or "production". In production the interactive API docs
# (/docs, /redoc, /openapi.json) are not served and the reset link is never
# written to a log, whatever the flags below say.
ENVIRONMENT=development

# REQUIRED. The application refuses to start without it: there is no default,
# because a default would mean signing JWTs with a key published in this
# repository, and anyone could then mint an administrator token. Placeholder
# values such as "change-me" are rejected too.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it invalidates every token already issued.
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/data_quality
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://datacenter.aaronbrumat.com.ar
FRONTEND_URL=http://127.0.0.1:3000

# --- Email / OAuth ----------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@aaronbrumat.com.ar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# --- Account creation -------------------------------------------------------
# There is no public sign-up: visitors use the demo sandbox, which needs no
# account, and real accounts are created by an administrator via POST /users.
#
# Signing in with Google authenticates an EXISTING user. Leave this false
# unless you deliberately want any Google account to provision itself.
GOOGLE_AUTO_PROVISION=false
# Comma separated addresses that may sign in with Google even without an
# account yet. Use this instead of the switch above to let a known person in.
GOOGLE_ALLOWED_EMAILS=
# Promoted to administrator at startup when the instance has none. Without it
# a fresh database simply has no administrator, which is the safe default.
BOOTSTRAP_ADMIN_EMAIL=

# --- Brute force protection -------------------------------------------------
# Two sliding windows per endpoint: one keyed on the client address, one on the
# address plus the account. The per-account window is cleared on a successful
# sign-in, so a legitimate user is never locked out by their own typos.
#
# Counters live in the process. On one instance they are exact; scaled out,
# each instance keeps its own, so the effective allowance multiplies. Adding
# Redis was judged not worth it for this project.
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=10
LOGIN_MAX_ATTEMPTS_PER_IP=40
LOGIN_RATE_WINDOW_SECONDS=900
FORGOT_PASSWORD_MAX_PER_ACCOUNT=3
FORGOT_PASSWORD_MAX_PER_IP=15
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=3600

# Writes the full password reset link to logs/password_reset.log and stdout so
# a local developer can follow the flow without SendGrid. That is a working
# credential in a file: forced off in production regardless of this value.
RESET_LINK_TO_LOGS=false

# Serve /docs, /redoc and /openapi.json. Unset means "only in development".
# EXPOSE_API_DOCS=false

# --- Demo sandbox -----------------------------------------------------------
# Master switch. false -> /demo/* returns 404 and no demo token can be minted.
DEMO_ENABLED=true

# Per-session quotas.
# 2 MB per CSV is derived from measured cost: parsing a CSV into records costs
# about 12x the file size in RAM and the quality pipeline about 28 us per row,
# so 2 MB is roughly 11k rows, ~250 ms of CPU and ~24 MB of peak memory.
DEMO_MAX_DATASETS=3
DEMO_MAX_FILE_SIZE_MB=2.0
DEMO_MAX_STORAGE_MB=6.0
DEMO_MAX_RUNS=20
DEMO_MAX_EXPORTS=30

# Session lifetime, in minutes.
DEMO_SESSION_TTL_MINUTES=45
DEMO_IDLE_TIMEOUT_MINUTES=20

# Rows generated for each seeded sandbox dataset.
DEMO_SEED_ROWS=400
DEMO_SEED_ANOMALY_RATE=0.12

# Abuse control. The per-hour limit is per client IP and held in process; the
# active-session cap is enforced in the database.
DEMO_RATE_LIMIT_PER_HOUR=12
DEMO_MAX_ACTIVE_SESSIONS=200

# Background cleanup loop, in seconds. 0 disables the loop.
DEMO_CLEANUP_INTERVAL_SECONDS=300

# Shared secret for POST /demo/maintenance/cleanup.
# Leave empty to keep that endpoint disabled (it returns 404 when unset).
DEMO_MAINTENANCE_TOKEN=
